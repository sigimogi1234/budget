rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 가계부 코드(링크의 #code=...)를 아는 사람만 해당 가계부를 읽고 쓸 수 있음.
    // households 목록 자체는 조회할 수 없으므로 코드를 모르면 접근 불가.
    match /households/{code}/{sub}/{doc} {
      allow read, write: if request.auth != null && code.size() >= 16;
    }
  }
}
